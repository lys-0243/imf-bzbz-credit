generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RECEPTION
  AGENT
  RESPONSABLE_CREDIT
  ANALYSTE
  CONFORMITE
  DG
  DGA
  CA
  ADMIN
}

enum EtapeWorkflow {
  AFFECTATION
  AGENT
  ANALYSE
  CONFORMITE
  VALIDATION_RC
  DIRECTION
  CONSEIL
}

enum TypeAvisIa {
  SUGGESTION_AGENTS
  PRECONTROLE
  ANALYSE
  CONFORMITE
  SYNTHESE_RC
  SYNTHESE_DIRECTION
  SYNTHESE_CONSEIL
}

enum StatutAvisIa {
  EN_ATTENTE
  EN_COURS
  PRET
  ECHEC
}

enum SourceManuel {
  IMF
  BCC
}

enum StatutCbsEnvoi {
  EN_ATTENTE
  ENVOYE
  ECHEC
}

enum DureeUnite {
  MOIS
  SEMAINES
}

enum FamilleProduit {
  SALAIRE
  ACTIVITE
}

enum PronosticRecommandation {
  ACCORD
  ACCORD_CONDITIONNEL
  REFUS
}

enum PronosticSource {
  IA
  REGLES
}

enum FormulaireCode {
  CF3
  CF4
  CF5_1_DEMANDEUR
  CF5_1_GARANT
  CF6_1
  PLAN_ROUTE
  HISTORIQUE
  PRE_COMITE
  DECISION_COMITE
  APPRO_PCA
  CF8
  RAPPORT_ANALYSE
  AVIS_CONFORMITE
}

enum DocumentEditable {
  LETTRE
  CONTRAT
  GAGE
  CAUTION
}

enum DossierEtat {
  ENREGISTRE
  EN_ATTENTE_ATTRIBUTION_AGENT
  AFFECTE
  DESCENTE
  RAPPORT_AGENT
  SCORING
  EN_ATTENTE_VALIDATION_RC
  ANALYSTE
  RETOUR_AGENT
  CONFORMITE
  RETOUR_ANALYSTE
  DIRECTION
  CONSEIL
  A_DECAISSER
  REJETE
}

model User {
  id                 String            @id @default(cuid())
  entraObjectId      String?           @unique
  email              String            @unique
  passwordHash       String
  displayName        String
  role               Role
  zoneId             String?
  zone               Zone?             @relation(fields: [zoneId], references: [id])
  disabledAt         DateTime?
  createdAt          DateTime          @default(now())
  dossiersAgent      Dossier[]         @relation("AgentDossiers")
  dossiersCrees      Dossier[]         @relation("CreatedByDossiers")
  dossiersAnalyste   Dossier[]         @relation("AnalysteDossiers")
  dossiersConformite Dossier[]         @relation("ConformiteDossiers")
  decisions          DecisionHumaine[]
}

model Zone {
  id       String    @id @default(cuid())
  code     String    @unique
  name     String
  users    User[]
  clients  Client[]
  communes Commune[]
}

model Commune {
  id      String   @id @default(cuid())
  code    String   @unique
  name    String
  zoneId  String
  zone    Zone     @relation(fields: [zoneId], references: [id])
  clients Client[]

  @@index([zoneId])
}

model Client {
  id              String    @id @default(cuid())
  fullName        String
  phone           String
  activityAddress String
  zoneId          String
  zone            Zone      @relation(fields: [zoneId], references: [id])
  communeId       String?
  commune         Commune?  @relation(fields: [communeId], references: [id])
  dossiers        Dossier[]
  createdAt       DateTime  @default(now())

  @@index([phone])
  @@index([fullName])
  @@index([communeId])
}

model ProduitCredit {
  id         String         @id @default(cuid())
  code       String         @unique
  label      String
  montantMin Float
  montantMax Float
  dureeMin   Int
  dureeMax   Int
  dureeUnite DureeUnite
  refPrefix  String
  famille    FamilleProduit
  actif      Boolean        @default(true)
  sortOrder  Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  dossiers   Dossier[]

  @@index([actif, sortOrder])
}

model Dossier {
  id            String              @id @default(cuid())
  reference     String              @unique
  produitId     String
  produit       ProduitCredit       @relation(fields: [produitId], references: [id])
  etat          DossierEtat         @default(ENREGISTRE)
  payload       Json
  clientId      String
  client        Client              @relation(fields: [clientId], references: [id])
  createdById   String?
  createdBy     User?               @relation("CreatedByDossiers", fields: [createdById], references: [id])
  agentId       String?
  agent         User?               @relation("AgentDossiers", fields: [agentId], references: [id])
  agentValideAt DateTime?
  /// Analyste titulaire (prise en charge) — conservé en cas de retour.
  analysteId    String?
  analyste      User?               @relation("AnalysteDossiers", fields: [analysteId], references: [id])
  /// Agent de conformité titulaire.
  conformiteId  String?
  conformite    User?               @relation("ConformiteDossiers", fields: [conformiteId], references: [id])
  /// Entrée dans l'état courant (délais par étape).
  etatDepuis    DateTime            @default(now())
  scoreValue    Int?
  scoreReasons  Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  transitions   Transition[]
  pieces        Piece[]
  auditLogs     AuditLog[]
  visite        VisiteTerrain?
  pronostics    Pronostic[]
  decisions     DecisionHumaine[]
  formulaires   DossierFormulaire[]
  documents     DocumentEdite[]
  avisIa        AvisIa[]
  cbsEnvois     CbsEnvoi[]

  @@index([reference])
  @@index([etat])
  @@index([agentId])
  @@index([produitId])
  @@index([createdById])
  @@index([analysteId])
  @@index([conformiteId])
}

model VisiteTerrain {
  id             String    @id @default(cuid())
  dossierId      String    @unique
  dossier        Dossier   @relation(fields: [dossierId], references: [id])
  agentId        String
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  checklistJson  Json?
  analyseCf2Json Json?
  rapportTexte   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([agentId])
}

model Transition {
  id        String       @id @default(cuid())
  dossierId String
  dossier   Dossier      @relation(fields: [dossierId], references: [id])
  fromEtat  DossierEtat?
  toEtat    DossierEtat
  comment   String?
  /// Points à corriger / non-conformités retenus lors d'un retour.
  details   Json?
  actorId   String
  createdAt DateTime     @default(now())

  @@index([dossierId])
}

model Piece {
  id           String   @id @default(cuid())
  dossierId    String
  dossier      Dossier  @relation(fields: [dossierId], references: [id])
  blobPath     String
  url          String?
  mimeType     String?
  bytes        Int?
  originalName String?
  kind         String
  createdAt    DateTime @default(now())

  @@index([dossierId, kind])
}

model AuditLog {
  id         String   @id @default(cuid())
  dossierId  String?
  dossier    Dossier? @relation(fields: [dossierId], references: [id])
  actorId    String?
  action     String
  entityType String
  entityId   String?
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([dossierId])
  @@index([actorId])
  @@index([createdAt])
  @@index([entityType])
  @@index([action])
}

/// Avis de pronostic (IA ou règles) calculé sur des faits déterministes.
model Pronostic {
  id             String                  @id @default(cuid())
  dossierId      String
  dossier        Dossier                 @relation(fields: [dossierId], references: [id])
  moteurVersion  String
  source         PronosticSource
  modele         String?
  facts          Json
  avis           Json
  recommandation PronosticRecommandation
  montantSuggere Float?
  /// Ratios CF 2.4 recalculés sur le montant proposé par l'IA (EvaluationProposition).
  evaluation     Json?
  ajuste         Boolean                 @default(false)
  erreurIa       String?
  createdById    String?
  createdAt      DateTime                @default(now())
  decisions      DecisionHumaine[]

  @@index([dossierId, createdAt])
}

/// Décision humaine prise au vu d'un pronostic (traçabilité IA / humain).
model DecisionHumaine {
  id               String                  @id @default(cuid())
  dossierId        String
  dossier          Dossier                 @relation(fields: [dossierId], references: [id])
  pronosticId      String?
  pronostic        Pronostic?              @relation(fields: [pronosticId], references: [id])
  actorId          String
  actor            User                    @relation(fields: [actorId], references: [id])
  role             Role
  etape            EtapeWorkflow?
  avisIaId         String?
  avisIa           AvisIa?                 @relation(fields: [avisIaId], references: [id])
  recommandation   PronosticRecommandation
  montantRetenu    Float?
  dureeRetenueMois Int?
  accordAvecIa     Boolean?
  commentaire      String?
  createdAt        DateTime                @default(now())

  @@index([dossierId])
  @@index([pronosticId])
  @@index([avisIaId])
}

/// Avis IA consultatif d'une étape (suggestion d'agents, analyse, conformité, synthèses).
model AvisIa {
  id          String            @id @default(cuid())
  dossierId   String
  dossier     Dossier           @relation(fields: [dossierId], references: [id])
  type        TypeAvisIa
  etape       EtapeWorkflow
  statut      StatutAvisIa      @default(EN_ATTENTE)
  source      PronosticSource?
  modele      String?
  /// Empreinte des données d'entrée : détecte un avis périmé.
  entreeHash  String?
  contenu     Json?
  /// Sections de manuels et versions utilisées (conformité).
  sources     Json?
  erreurIa    String?
  tentatives  Int               @default(0)
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  decisions   DecisionHumaine[]

  @@index([dossierId, type, createdAt])
  @@index([statut])
}

/// Manuel de procédures IMF ou instruction BCC (RAG conformité).
model Manuel {
  id          String          @id @default(cuid())
  titre       String
  source      SourceManuel
  reference   String?
  version     String
  dateEffet   DateTime?
  actif       Boolean         @default(true)
  blobPath    String?
  mimeType    String?
  nomFichier  String?
  nbMots      Int             @default(0)
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  sections    ManuelSection[]

  @@index([actif])
}

model ManuelSection {
  id               String                   @id @default(cuid())
  manuelId         String
  manuel           Manuel                   @relation(fields: [manuelId], references: [id], onDelete: Cascade)
  ordre            Int
  numero           String                   @default("")
  titre            String                   @default("")
  contenu          String                   @db.Text
  /// Textes sans accents (normalisés par l'application) pour la recherche.
  titreRecherche   String                   @default("")
  contenuRecherche String                   @default("") @db.Text
  /// Colonne générée (config french), index GIN — voir migration.
  tsv              Unsupported("tsvector")?

  @@index([manuelId, ordre])
}

/// Outbox des envois au core banking (reprise automatique).
model CbsEnvoi {
  id              String         @id @default(cuid())
  dossierId       String
  dossier         Dossier        @relation(fields: [dossierId], references: [id])
  idempotencyKey  String         @unique
  payload         Json
  statut          StatutCbsEnvoi @default(EN_ATTENTE)
  tentatives      Int            @default(0)
  dernierMessage  String?
  prochainEssaiAt DateTime       @default(now())
  envoyeAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([statut, prochainEssaiAt])
  @@index([dossierId])
}

/// Feuilles Analyse_AGR.xlsx hors CF1/CF2 (CF3, CF4, CF5.1, PV comité…), en JSON normalisé par @imf/shared.
model DossierFormulaire {
  id          String         @id @default(cuid())
  dossierId   String
  dossier     Dossier        @relation(fields: [dossierId], references: [id])
  code        FormulaireCode
  data        Json
  updatedById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([dossierId, code])
}

/// Paramètres de l'IMF (une seule ligne, id = "default").
model ParametresImf {
  id          String   @id @default("default")
  data        Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// Document juridique retouché dans l'éditeur web (HTML nettoyé) ; absent = généré depuis le dossier.
model DocumentEdite {
  id          String           @id @default(cuid())
  dossierId   String
  dossier     Dossier          @relation(fields: [dossierId], references: [id])
  doc         DocumentEditable
  contenuHtml String           @db.Text
  version     Int              @default(1)
  updatedById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([dossierId, doc])
}
