generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RECEPTION
  AGENT
  RESPONSABLE_CREDIT
  ANALYSTE
  CONFORMITE
  DG
  CA
  ADMIN
}

enum DureeUnite {
  MOIS
  SEMAINES
}

enum FamilleProduit {
  SALAIRE
  ACTIVITE
}

enum DossierEtat {
  ENREGISTRE
  EN_ATTENTE_ATTRIBUTION_AGENT
  AFFECTE
  DESCENTE
  RAPPORT_AGENT
  SCORING
  EN_ATTENTE_VALIDATION_RC
  ANALYSTE
  RETOUR_AGENT
  CONFORMITE
  RETOUR_ANALYSTE
  DIRECTION
  CONSEIL
  A_DECAISSER
  REJETE
}

model User {
  id            String    @id @default(cuid())
  entraObjectId String?   @unique
  email         String    @unique
  passwordHash  String
  displayName   String
  role          Role
  zoneId        String?
  zone          Zone?     @relation(fields: [zoneId], references: [id])
  disabledAt    DateTime?
  createdAt     DateTime  @default(now())
  dossiersAgent Dossier[] @relation("AgentDossiers")
  dossiersCrees Dossier[] @relation("CreatedByDossiers")
}

model Zone {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  users     User[]
  clients   Client[]
  communes  Commune[]
}

model Commune {
  id       String   @id @default(cuid())
  code     String   @unique
  name     String
  zoneId   String
  zone     Zone     @relation(fields: [zoneId], references: [id])
  clients  Client[]

  @@index([zoneId])
}

model Client {
  id              String    @id @default(cuid())
  fullName        String
  phone           String
  activityAddress String
  zoneId          String
  zone            Zone      @relation(fields: [zoneId], references: [id])
  communeId       String?
  commune         Commune?  @relation(fields: [communeId], references: [id])
  dossiers        Dossier[]
  createdAt       DateTime  @default(now())

  @@index([phone])
  @@index([fullName])
  @@index([communeId])
}

model ProduitCredit {
  id         String         @id @default(cuid())
  code       String         @unique
  label      String
  montantMin Float
  montantMax Float
  dureeMin   Int
  dureeMax   Int
  dureeUnite DureeUnite
  refPrefix  String
  famille    FamilleProduit
  actif      Boolean        @default(true)
  sortOrder  Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  dossiers   Dossier[]

  @@index([actif, sortOrder])
}

model Dossier {
  id            String         @id @default(cuid())
  reference     String         @unique
  produitId     String
  produit       ProduitCredit  @relation(fields: [produitId], references: [id])
  etat          DossierEtat    @default(ENREGISTRE)
  payload       Json
  clientId      String
  client        Client         @relation(fields: [clientId], references: [id])
  createdById   String?
  createdBy     User?          @relation("CreatedByDossiers", fields: [createdById], references: [id])
  agentId       String?
  agent         User?          @relation("AgentDossiers", fields: [agentId], references: [id])
  agentValideAt DateTime?
  scoreValue    Int?
  scoreReasons  Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  transitions   Transition[]
  pieces        Piece[]
  auditLogs     AuditLog[]
  visite        VisiteTerrain?

  @@index([reference])
  @@index([etat])
  @@index([agentId])
  @@index([produitId])
  @@index([createdById])
}

model VisiteTerrain {
  id            String    @id @default(cuid())
  dossierId     String    @unique
  dossier       Dossier   @relation(fields: [dossierId], references: [id])
  agentId       String
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  checklistJson Json?
  rapportTexte  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([agentId])
}

model Transition {
  id        String       @id @default(cuid())
  dossierId String
  dossier   Dossier      @relation(fields: [dossierId], references: [id])
  fromEtat  DossierEtat?
  toEtat    DossierEtat
  comment   String?
  actorId   String
  createdAt DateTime     @default(now())

  @@index([dossierId])
}

model Piece {
  id        String   @id @default(cuid())
  dossierId String
  dossier   Dossier  @relation(fields: [dossierId], references: [id])
  blobPath  String
  kind      String
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  dossierId  String?
  dossier    Dossier? @relation(fields: [dossierId], references: [id])
  actorId    String?
  action     String
  entityType String
  entityId   String?
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([dossierId])
  @@index([actorId])
  @@index([createdAt])
  @@index([entityType])
  @@index([action])
}
