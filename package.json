{
  "name": "imf-credit",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/mobile",
    "packages/shared",
    "packages/assets"
  ],
  "scripts": {
    "dev:api": "npm run build -w @imf/shared && npm run start:dev -w @imf/api",
    "dev:web": "npm run dev -w @imf/web",
    "dev:mobile": "npm run start -w @imf/mobile -- --clear",
    "build:shared": "npm run build -w @imf/shared",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "ts-node --transpile-only --compiler-options {\"module\":\"CommonJS\",\"rootDir\":\".\"} prisma/seed.ts"
  },
  "devDependencies": {
    "prisma": "^6.14.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "bcryptjs": "^3.0.2"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@scarf/scarf@1.4.0": true,
    "prisma@6.19.3": true
  }
}
