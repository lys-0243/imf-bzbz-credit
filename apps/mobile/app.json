{
  "expo": {
    "name": "IMF Bisou Bisou",
    "slug": "imf-credit",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "android": {
      "package": "cd.imf.credit",
      "statusBar": {
        "barStyle": "dark-content",
        "backgroundColor": "#f6f4ef",
        "translucent": false
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png",
      "name": "IMF Bisou Bisou — Réception"
    },
    "extra": {
      "apiUrl": "http://10.0.2.2:3001"
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ]
    ]
  }
}
