# Avec docker-compose : postgresql://imf:imf@localhost:5432/imf_credit?schema=public
DATABASE_URL="postgresql://postgres:dipro@localhost:5432/bizoubizou?schema=public"
PORT=3001
CORE_BANKING_PROVIDER=mock
WEB_ORIGIN="http://localhost:3000,http://localhost:8081"
# En production (NODE_ENV=production) : JWT_SECRET et WEB_ORIGIN sont obligatoires.
JWT_SECRET="imf-dev-jwt-secret-change-me"
JWT_EXPIRES_IN="7d"
# Expo web uniquement (prod). En dev : même hôte que la page, port 3001
# EXPO_PUBLIC_WEB_API_URL=https://api.example.com
NEXT_PUBLIC_API_URL=http://localhost:3001
# URL de l'instance web réception (Expo web)
NEXT_PUBLIC_RECEPTION_URL=http://localhost:8081
# Claude (API Anthropic) : clé créée dans la Console, crédits API facturés à part
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Profondeur de réflexion : low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# Surcharge du modèle pour le pronostic (vide = ANTHROPIC_MODEL)
ANTHROPIC_MODEL_PRONOSTIC=
# Stockage des pièces : local = disque du serveur (Droplet DigitalOcean)
STORAGE_DRIVER=local
# Dossier racine, hors du dossier de l'appli. Obligatoire en production.
# Dev : vide = ./uploads du répertoire de lancement de l'API
# Prod Droplet : /var/lib/imf/uploads
STORAGE_LOCAL_DIR=
# Workers d'arrière-plan (1 = désactivé) : avis IA par étape, envois au core banking
ASSISTANT_WORKER_DISABLED=
CBS_OUTBOX_DISABLED=
